{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cynrath/ackit-spec-kit-bridge/schemas/verification-bundle.schema.json",
  "title": "State-bound verification bundle",
  "type": "object",
  "required": ["schema", "schemaVersion", "profile", "subjectDigest", "evidenceDigest", "checks", "evidence"],
  "properties": {
    "schema": { "const": "ackit.speckit.verification-bundle.v1" },
    "schemaVersion": { "const": 1 },
    "bridgeVersion": { "type": "string" },
    "createdAt": { "type": "string" },
    "profile": { "enum": ["quick", "standard", "high-risk"] },
    "feature": { "type": ["string", "null"] },
    "ackitTask": { "type": ["string", "null"] },
    "subjectDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "exitCode", "status", "summary"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "exitCode": { "type": "number" },
          "status": { "enum": ["pass", "fail", "skip"] },
          "summary": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "evidence": { "type": "array" }
  },
  "additionalProperties": true
}
